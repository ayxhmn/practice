{
    "manifest_version": 3,
    "name": "Disable Recommended Section - youtube",
    "version": "1.0",
    "description": "Disables YouTube's recommended videos and homepage feed.",
    "permissions": [
      "activeTab"
    ],
    "background": {
      "service_worker": "background.js"
    },
    "content_scripts": [
      {
        "matches": ["https://www.youtube.com/*"],
        "js": ["content.js"],
        "run_at": "document_end"
      }
    ],
    "host_permissions": [
      "http://*/*",
      "https://*/*"
    ]
}